# TRANSFER_STATUS_OVERRIDES={"binance:upbit:BTC":{"withdrawEnabled":true,"depositEnabled":true,"network":"BTC"},"bitget:bithumb:*":{"withdrawEnabled":false,"depositEnabled":true,"network":"manual","message":"manual maintenance block"}}
