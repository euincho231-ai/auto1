MAX_API_LATENCY_MS=1200
MAX_UNHEDGED_MS=3000
DAILY_LOSS_LIMIT_KRW=500000
SHORT_CLOSE_TOLERANCE_PERCENT=1

# Absolute safety defaults
PAPER_TRADING=true
LIVE_TRADING=false
ENABLE_WITHDRAWAL=false
ENABLE_AUTO_REBALANCE=false
ENABLE_INTERNAL_TRANSFER=false
WITHDRAWAL_TRANSPORT=disabled

# Live trading stays locked unless every flag below is deliberately changed.
# Supported live route in this prototype: upbit domestic sell + binance spot buy + binance USD-M short.
ALLOW_LIVE_ORDERS=false
LIVE_ORDER_TRANSPORT=disabled
LIVE_STRATEGY_CONFIRMED=false
LIVE_MAX_ORDER_NOTIONAL_USDT=25
INTERNAL_TRANSFER_TRANSPORT=disabled

