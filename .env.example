# Default strategy settings
MIN_PREMIUM_PERCENT=0.15
ORDER_NOTIONAL_USDT=100
FEE_BUFFER_PERCENT=0.12
MAX_SLIPPAGE_PERCENT=0.25
MAX_AUTO_PREMIUM_PERCENT=20
MAX_DOMESTIC_PRICE_DIVERGENCE_PERCENT=15
MIN_DEPTH_USDT=50
TRANSFER_MIN_SECONDS=480
