REQUIRE_TRANSFER_STATUS_FOR_PAPER=true
REQUIRE_HEDGE_STATUS_FOR_PAPER=true
MIN_HEDGE_BASIS_PERCENT=0
MAX_HEDGE_BASIS_PERCENT=1.5
